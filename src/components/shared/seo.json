{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "description": "Metadados para Google e redes (título, descrição, imagens Open Graph)"
  },
  "options": {},
  "attributes": {
    "defaultTitle": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "text",
      "maxLength": 160
    },
    "siteName": {
      "type": "string",
      "maxLength": 100
    },
    "keywords": {
      "type": "string",
      "maxLength": 255
    },
    "openGraphImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "twitterImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "ogTitle": {
      "type": "string",
      "maxLength": 60
    },
    "ogDescription": {
      "type": "text",
      "maxLength": 160
    },
    "twitterCard": {
      "type": "enumeration",
      "enum": ["summary", "summary_large_image"],
      "default": "summary_large_image"
    }
  },
  "config": {
    "metadatas": {
      "defaultTitle": {
        "edit": { "label": "Título (SEO)" },
        "list": { "label": "Título" }
      },
      "description": {
        "edit": { "label": "Descrição (meta)" },
        "list": { "label": "Descrição" }
      },
      "siteName": {
        "edit": { "label": "Nome do site" },
        "list": { "label": "Site" }
      },
      "keywords": {
        "edit": { "label": "Palavras-chave" },
        "list": { "label": "Keywords" }
      },
      "openGraphImage": {
        "edit": { "label": "Imagem Open Graph" },
        "list": { "label": "Imagem OG" }
      },
      "twitterImage": {
        "edit": { "label": "Imagem Twitter/X" },
        "list": { "label": "Imagem Twitter" }
      },
      "ogTitle": {
        "edit": { "label": "Título Open Graph" },
        "list": { "label": "OG título" }
      },
      "ogDescription": {
        "edit": { "label": "Descrição Open Graph" },
        "list": { "label": "OG descrição" }
      },
      "twitterCard": {
        "edit": { "label": "Tipo de card Twitter/X" },
        "list": { "label": "Twitter card" }
      }
    }
  }
}