{
  "collectionName": "components_article_text_blocks",
  "info": {
    "displayName": "Bloco de texto",
    "description": "Texto rico (TinyMCE), mesmo editor usado nos tratamentos"
  },
  "options": {},
  "attributes": {
    "content": {
      "type": "customField",
      "customField": "global::tinymce-html",
      "required": true
    },
    "alignment": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "default": "left"
    },
    "backgroundColor": {
      "type": "string",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "padding": {
      "type": "enumeration",
      "enum": ["none", "small", "medium", "large"],
      "default": "medium"
    }
  },
  "config": {
    "metadatas": {
      "content": {
        "edit": { "label": "Conteúdo" },
        "list": { "label": "Conteúdo" }
      },
      "alignment": {
        "edit": { "label": "Alinhamento" },
        "list": { "label": "Alinhamento" }
      },
      "backgroundColor": {
        "edit": { "label": "Cor de fundo (hex)" },
        "list": { "label": "Cor de fundo" }
      },
      "padding": {
        "edit": { "label": "Espaçamento vertical" },
        "list": { "label": "Padding" }
      }
    }
  }
}
