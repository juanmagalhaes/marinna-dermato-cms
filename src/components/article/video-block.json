{
  "collectionName": "components_article_video_blocks",
  "info": {
    "displayName": "Bloco de vídeo",
    "description": "Vídeo incorporado (Instagram, YouTube, Vimeo ou URL de arquivo)"
  },
  "options": {},
  "attributes": {
    "videoType": {
      "type": "enumeration",
      "enum": ["instagram", "youtube", "vimeo", "upload"],
      "required": true
    },
    "videoUrl": {
      "type": "string",
      "required": true,
      "regex": "^https?://.*"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "caption": {
      "type": "string",
      "maxLength": 500
    },
    "alignment": {
      "type": "enumeration",
      "enum": ["left", "center", "right", "full-width"],
      "default": "center"
    },
    "size": {
      "type": "enumeration",
      "enum": ["small", "medium", "large", "full"],
      "default": "medium"
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "muted": {
      "type": "boolean",
      "default": true
    }
  },
  "config": {
    "metadatas": {
      "videoType": {
        "edit": { "label": "Tipo de vídeo" },
        "list": { "label": "Tipo" }
      },
      "videoUrl": {
        "edit": { "label": "URL do vídeo" },
        "list": { "label": "URL" }
      },
      "thumbnail": {
        "edit": { "label": "Miniatura (opcional)" },
        "list": { "label": "Miniatura" }
      },
      "caption": {
        "edit": { "label": "Legenda" },
        "list": { "label": "Legenda" }
      },
      "alignment": {
        "edit": { "label": "Alinhamento" },
        "list": { "label": "Alinhamento" }
      },
      "size": {
        "edit": { "label": "Tamanho" },
        "list": { "label": "Tamanho" }
      },
      "autoplay": {
        "edit": { "label": "Reprodução automática" },
        "list": { "label": "Autoplay" }
      },
      "muted": {
        "edit": { "label": "Sem som por padrão" },
        "list": { "label": "Mudo" }
      }
    }
  }
}
