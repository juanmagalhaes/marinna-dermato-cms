{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Categoria",
    "description": "Categorias dos artigos do blog"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 100
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "color": {
      "type": "string",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
      "default": "#3B82F6"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "categories"
    }
  },
  "config": {
    "metadatas": {
      "name": {
        "edit": { "label": "Nome" },
        "list": { "label": "Nome" }
      },
      "slug": {
        "edit": { "label": "Slug (identificador na URL)" },
        "list": { "label": "Slug" }
      },
      "description": {
        "edit": { "label": "Descrição" },
        "list": { "label": "Descrição" }
      },
      "color": {
        "edit": { "label": "Cor (hex)" },
        "list": { "label": "Cor" }
      },
      "articles": {
        "edit": { "label": "Artigos" },
        "list": { "label": "Artigos" }
      }
    }
  }
}
