{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Artigo",
    "description": "Artigos do blog com blocos de conteúdo (texto, imagem, vídeo, citação)"
  },
  "options": {
    "draftAndPublish": true,
    "reviewWorkflows": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 500
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "articles"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "article.text-block",
        "article.image-block",
        "article.video-block",
        "article.quote-block"
      ]
    }
  },
  "config": {
    "metadatas": {
      "title": {
        "edit": { "label": "Título" },
        "list": { "label": "Título" }
      },
      "slug": {
        "edit": { "label": "Slug (identificador na URL)" },
        "list": { "label": "Slug" }
      },
      "excerpt": {
        "edit": { "label": "Resumo / chamada" },
        "list": { "label": "Resumo" }
      },
      "featuredImage": {
        "edit": { "label": "Imagem de destaque" },
        "list": { "label": "Imagem" }
      },
      "categories": {
        "edit": { "label": "Categorias" },
        "list": { "label": "Categorias" }
      },
      "tags": {
        "edit": { "label": "Tags" },
        "list": { "label": "Tags" }
      },
      "seo": {
        "edit": { "label": "SEO" },
        "list": { "label": "SEO" }
      },
      "blocks": {
        "edit": { "label": "Blocos de conteúdo" },
        "list": { "label": "Blocos" }
      }
    }
  }
}
